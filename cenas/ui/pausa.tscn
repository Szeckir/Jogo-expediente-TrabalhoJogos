[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/pausa.gd" id="1_pausa"]

[node name="Pausa" type="CanvasLayer"]
process_mode = 2
layer = 15
visible = false
script = ExtResource("1_pausa")

[node name="Fundo" type="ColorRect" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.96, 0.95, 0.93, 0.92)

[node name="Centro" type="CenterContainer" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Coluna" type="VBoxContainer" parent="Centro"]
layout_mode = 2
custom_minimum_size = Vector2(340.0, 0.0)
theme_override_constants/separation = 16

[node name="Titulo" type="Label" parent="Centro/Coluna"]
layout_mode = 2
theme_override_colors/font_color = Color(0.1, 0.1, 0.1, 1.0)
theme_override_font_sizes/font_size = 26
text = "EXPEDIENTE SUSPENSO"
horizontal_alignment = 1

[node name="Rotulo" type="Label" parent="Centro/Coluna"]
layout_mode = 2
theme_override_colors/font_color = Color(0.45, 0.45, 0.45, 1.0)
theme_override_font_sizes/font_size = 13
text = "Volume"

[node name="Volume" type="HSlider" parent="Centro/Coluna"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(340.0, 24.0)
max_value = 1.0
step = 0.05
value = 0.6

[node name="Continuar" type="Button" parent="Centro/Coluna"]
layout_mode = 2
custom_minimum_size = Vector2(0.0, 38.0)
text = "Continuar"

[node name="Recomecar" type="Button" parent="Centro/Coluna"]
layout_mode = 2
custom_minimum_size = Vector2(0.0, 38.0)
