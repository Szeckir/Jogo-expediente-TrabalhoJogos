[connection signal="value_changed" from="Centro/Coluna/Volume" to="." method="_ao_mudar_volume"]
[connection signal="pressed" from="Centro/Coluna/Continuar" to="." method="fechar"]
[connection signal="pressed" from="Centro/Coluna/Recomecar" to="." method="_ao_recomecar"]
